classifier_model <- test_glu_classifier(autonoms_output, metadata)
library(dplyr)
library(tidyr)
library(caret)
library(randomForest)
test_glu_classifier <- function(long_data, metadata) {
# Convert Experimental.group to character for proper matching
metadata <- metadata %>%
mutate(Experimental.group = as.character(Experimental.group))
# Filter metadata for non-spermine conditions and assign labels
metadata_ns <- metadata %>%
filter(Experimental.group %in% c("Baseline growth with no supplementation or treatment.",
"Growth with low glutamate supplementation, no spermine treatment.",
"Growth with high glutamate supplementation, no spermine treatment.")) %>%
mutate(glu_label = case_when(
Experimental.group == "Baseline growth with no supplementation or treatment." ~ 0,
Experimental.group == "Growth with low glutamate supplementation, no spermine treatment." ~ 1,
Experimental.group == "Growth with high glutamate supplementation, no spermine treatment." ~ 2,
TRUE ~ NA_integer_
)) %>%
filter(!is.na(glu_label)) %>%
mutate(glu_label = factor(glu_label, levels = c(0, 1, 2)))
# Convert long-format data to wide format: one row per sample, each Molecule_Adduct as a column.
wide_data <- long_data %>%
mutate(Molecule_Adduct = paste(Molecule.Name, Precursor.Adduct, sep = "_"),
Normalized.Area = as.numeric(as.character(Normalized.Area))) %>%
select(Replicate.Name, Molecule_Adduct, Normalized.Area) %>%
pivot_wider(names_from = Molecule_Adduct, values_from = Normalized.Area)
# Merge with filtered metadata (matching Replicate.Name with metadata's sample)
data_merged <- wide_data %>%
left_join(metadata_ns, by = c("Replicate.Name" = "Sample"))
# Remove rows missing key identifiers or glu_label
data_clean <- data_merged %>%
filter(!is.na(Replicate.Name), !is.na(glu_label))
# Remove identifier columns (Replicate.Name and Experimental.group)
model_data <- data_clean %>% select(-Replicate.Name, -Experimental.group)
# Use caret's preProcess to median-impute any remaining NAs in numeric predictors.
preProcValues <- preProcess(model_data, method = c("medianImpute"))
model_data_imputed <- predict(preProcValues, model_data)
# Remove any columns that have only one unique value
model_data_imputed <- model_data_imputed %>%
select(where(~ n_distinct(.) > 1))
# Optional: check for any remaining NAs
if(any(is.na(model_data_imputed))) {
warning("There are still NA values in the imputed data!")
}
# Set up 5-fold cross-validation with saving of predictions.
train_control <- trainControl(method = "cv", number = 5, savePredictions = "final")
# Train a Random Forest classifier using glu_label as the target.
set.seed(123)  # For reproducibility.
rf_model <- train(glu_label ~ .,
data = model_data_imputed,
method = "rf",
trControl = train_control)
print(rf_model)
# Compute a confusion matrix from cross-validated predictions.
cm <- confusionMatrix(rf_model$pred$pred, rf_model$pred$obs)
print(cm)
# Report per-class accuracy metrics (e.g., sensitivity is the recall for each class)
cat("\nPer-class performance metrics (byClass):\n")
print(cm$byClass)
return(rf_model)
}
