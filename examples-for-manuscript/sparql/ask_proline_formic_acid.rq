PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX : <http://hypo.project-genesis.io/>

ASK
{
    GRAPH :experiments {
        # Find the study
        ?study a obo:OBI_0500000 ;
            rdfs:label ?studyLabel ;
            obo:BFO_0000051
                # Baseline growth
                ?assay_base,
                # Proline supplemented
                ?assay_aa,
                # Proline supplemented with formic acid
                ?assay_aa_supp .

        ### Reference experiment
        ?assay_base a obo:OBI_0000070 ;
            # has specified input
            obo:OBI_0000293 ?cellculture_base,
                ?medium_base,
                ?treatment_base .

        # Find cell culture
        ?cellculture_base a obo:OBI_0001876 ;
            # With the right medium
            obo:BFO_0000051 ?medium_base ,
                # ..and of course S. cerevisiae
                :saccaharomyces-cerevisiae-population .

        ?medium_base a obo:OBI_0000079 ;
            :baselineMedia "Minimal media without amino acids" .

        ?treatment_base a :treatment .

        # Not supplemented or treated
        FILTER NOT EXISTS { ?medium_base :mediaSupplementation ?_base_supp_miss }
        FILTER NOT EXISTS { ?treatment_base :treatmentWithChemical ?_base_treat_miss }
        
        ### Supplemented with Proline, no treatement
        ?assay_aa a obo:OBI_0000070 ;
            obo:OBI_0000293 ?cellculture_aa,
                ?medium_aa,
                ?treatment_aa .

        ?cellculture_aa a obo:OBI_0001876 ;
            obo:BFO_0000051 ?medium_aa ,
                :saccaharomyces-cerevisiae-population .

        ?medium_aa a obo:OBI_0000079 ;
            :baselineMedia "Minimal media without amino acids" ;
            # Supplemented with Proline
            :mediaSupplementation obo:CHEBI_17203 .

        ?treatment_aa a :treatment .

        # Not treated
        FILTER NOT EXISTS { ?treatment_aa :treatmentWithChemical ?_aa_treat_miss }

        ### Supplemented with Proline, treated with formic acid
        ?assay_aa_supp a obo:OBI_0000070 ;
            obo:OBI_0000293 ?cellculture_aa_supp,
                ?medium_aa_supp,
                ?treatment_aa_supp .

        ?cellculture_aa_supp a obo:OBI_0001876 ;
            obo:BFO_0000051 ?medium_aa_supp ,
                :saccaharomyces-cerevisiae-population .

        ?medium_aa_supp a obo:OBI_0000079 ;
            :baselineMedia "Minimal media without amino acids" ;
            # Supplemented with Proline
            :mediaSupplementation obo:CHEBI_17203 .

        ?treatment_aa_supp a :treatment ;
            # Treated with formic acid
            :treatmentWithChemical obo:CHEBI_30751 .
    }
}