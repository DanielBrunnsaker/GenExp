PREFIX : <http://hypo.project-genesis.io/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX hypo: <http://hypo.project-genesis.io/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?h ?s1 ?s2 ?p1 ?p2 ?ql1 ?hypo_aa ?ql2 ?hypo_supp ?study ?studyLabel ?GLMCoeff_aa_test
  ?pVal_aa_test ?GLMCoeff_aa_supp_test ?pVal_aa_supp_test
WHERE {
  GRAPH :hypothesis-metadata {
    ?h dcterms:created [] .
  }
  OPTIONAL {
    GRAPH ?h {
      [] a owl:Restriction ;
         owl:onProperty :implies ;
         ^rdfs:subClassOf ?s1 ;
         owl:someValuesFrom ?s2 .
    }
    GRAPH :states {
      :organismState ^rdfs:subClassOf ?s1, ?s2 .
      ?s1 rdfs:subClassOf [
           a owl:Restriction ;
           owl:onProperty :stateHasObservable ;
           owl:someValuesFrom ?p1
         ] .
      ?s2 rdfs:subClassOf [
           a owl:Restriction ;
           owl:onProperty :stateHasObservable ;
           owl:someValuesFrom ?p2
         ] .
    }
    GRAPH :phenotypes {
      ?p1 rdfs:subClassOf obo:APO_0000095, [
           a owl:Restriction ;
           owl:onProperty ?ql1 ;
           owl:someValuesFrom ?pref1
         ], [
           a owl:Restriction ;
           owl:onProperty :accumulationOfChemical ;
           owl:someValuesFrom ?hypo_aa
         ] .
      ?p2 rdfs:subClassOf ?o2, [
           a owl:Restriction ;
           owl:onProperty ?ql2 ;
           owl:someValuesFrom ?pref2
         ], [
           a owl:Restriction ;
           owl:onProperty :resistanceToChemical ;
           owl:someValuesFrom ?hypo_supp
         ] .
    }
    GRAPH :ontology {
      {
        ?ql1 rdfs:subPropertyOf* :differsFrom .
      }
      UNION
      {
        ?ql1 rdfs:subPropertyOf* :notDiffersFrom .
      }
      {
        ?ql2 rdfs:subPropertyOf* :differsFrom .
      }
      UNION
      {
        ?ql2 rdfs:subPropertyOf* :notDiffersFrom .
      }
      ?o2 rdfs:subClassOf* obo:APO_0000087 .
    }
    OPTIONAL {
      GRAPH :experiments {
        ?study a obo:OBI_0500000 ;
               rdfs:label ?studyLabel ;
               obo:BFO_0000051 ?assay_base, ?assay_aa, ?assay_aa_supp .
        ?assay_base a obo:OBI_0000070 ;
                    obo:OBI_0000293 ?cellculture_base, ?medium_base, ?treatment_base .
        ?cellculture_base a obo:OBI_0001876 ;
                          obo:BFO_0000051 ?medium_base, :saccaharomyces-cerevisiae-population .
        ?medium_base a obo:OBI_0000079 ;
                     :baselineMedia "Minimal media without amino acids" .
        ?treatment_base a :treatment .
        FILTER NOT EXISTS {
          ?medium_base :mediaSupplementation ?_base_supp_miss .
        }
        FILTER NOT EXISTS {
          ?treatment_base :treatmentWithChemical ?_base_treat_miss .
        }
        ?assay_aa a obo:OBI_0000070 ;
                  obo:OBI_0000293 ?cellculture_aa, ?medium_aa, ?treatment_aa .
        ?cellculture_aa a obo:OBI_0001876 ;
                        obo:BFO_0000051 ?medium_aa, :saccaharomyces-cerevisiae-population .
        ?medium_aa a obo:OBI_0000079 ;
                   :baselineMedia "Minimal media without amino acids" ;
                   :mediaSupplementation ?hypo_aa .
        ?treatment_aa a :treatment .
        FILTER NOT EXISTS {
          ?treatment_aa :treatmentWithChemical ?_aa_treat_miss .
        }
        ?assay_aa_supp a obo:OBI_0000070 ;
                       obo:OBI_0000293 ?cellculture_aa_supp, ?medium_aa_supp, ?treatment_aa_supp .
        ?cellculture_aa_supp a obo:OBI_0001876 ;
                             obo:BFO_0000051 ?medium_aa_supp, :saccaharomyces-cerevisiae-population .
        ?medium_aa_supp a obo:OBI_0000079 ;
                        :baselineMedia "Minimal media without amino acids" ;
                        :mediaSupplementation ?hypo_aa .
        ?treatment_aa_supp a :treatment ;
                           :treatmentWithChemical ?hypo_supp .
      }
      GRAPH :growth-data {
        ?test_aa a :AUCForestComparativeTest ;
                 :referenceCondition ?ref_growth_aa_test ;
                 :testCondition ?test_growth_aa_test ;
                 :GLMCoefficient ?GLMCoeff_aa_test ;
                 :pValue ?pVal_aa_test .
        ?ref_growth_aa_test :growthDataFromAssay ?assay_base .
        ?test_growth_aa_test :growthDataFromAssay ?assay_aa .
        ?test_aa_supp a :AUCForestComparativeTest ;
                      :referenceCondition ?ref_growth_aa_supp_test ;
                      :testCondition ?test_growth_aa_supp_test ;
                      :GLMCoefficient ?GLMCoeff_aa_supp_test ;
                      :pValue ?pVal_aa_supp_test .
        ?ref_growth_aa_supp_test :growthDataFromAssay ?assay_base .
        ?test_growth_aa_supp_test :growthDataFromAssay ?assay_aa_supp .
      }
    }
  }
}