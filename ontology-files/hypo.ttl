   owl:annotatedSource obo:APO_0000017 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Features of ascomycete fungal cells, cultures, or colonies that can be detected, observed, measured, or monitored." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000018
obo:APO_0000018 rdf:type owl:Class ;
                obo:IAO_0000115 "A description of the experimental approach." ;
