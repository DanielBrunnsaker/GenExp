   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation type is not specified in the reference." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000016
obo:APO_0000016 rdf:type owl:Class ;
                obo:IAO_0000115 "OBSOLETE. This term was not defined before being made obsolete." ;
                oboInOwl:hasAlternativeId "YPO:0000016" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000016" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:SGD ;
                rdfs:comment "This term was made obsolete because there was overlap with another term unspecified. The term unspecified will be used in cases where a more appropriate descriptor cannot be identified." ;
                rdfs:label "not yet recorded" ;
                owl:deprecated "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000016 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "OBSOLETE. This term was not defined before being made obsolete." ;
   oboInOwl:hasDbXref "SGD:RSN"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000017
obo:APO_0000017 rdf:type owl:Class ;
                obo:IAO_0000115 "Features of ascomycete fungal cells, cultures, or colonies that can be detected, observed, measured, or monitored." ;
                oboInOwl:hasAlternativeId "YPO:0000017" ;
                oboInOwl:hasOBONamespace "observable" ;
                oboInOwl:id "APO:0000017" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "observable" .

