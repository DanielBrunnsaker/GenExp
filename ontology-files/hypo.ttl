###  http://purl.obolibrary.org/obo/APO_0000153
obo:APO_0000153 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000102 ;
                obo:IAO_0000115 "The formation of smaller than wild-type colonies on fermentable carbon sources (e.g., glucose), due to a respiratory defect. The respiratory defect could result from mutation or loss of the mitochondrial genome, or from a nuclear mutation affecting respiration. The fermentation of glucose produces ethanol, which is metabolized by the respiratory pathway in wild-type cells and contributes to colony size; respiratory-deficient mutants are unable to utilize this ethanol." ;
                oboInOwl:hasAlternativeId "YPO:0000153" ;
                oboInOwl:hasOBONamespace "observable" ;
                oboInOwl:id "APO:0000153" ;
                oboInOwl:inSubset apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "petite" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000153 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The formation of smaller than wild-type colonies on fermentable carbon sources (e.g., glucose), due to a respiratory defect. The respiratory defect could result from mutation or loss of the mitochondrial genome, or from a nuclear mutation affecting respiration. The fermentation of glucose produces ethanol, which is metabolized by the respiratory pathway in wild-type cells and contributes to colony size; respiratory-deficient mutants are unable to utilize this ethanol." ;
   oboInOwl:hasDbXref "PMID:9301019" ,
                      "SGD:mcc"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000154
obo:APO_0000154 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000102 ;
                obo:IAO_0000115 "The petite-negative phenotype arises from mutation in a nuclear gene that is not essential in an otherwise wild-type strain with an intact mitochondrial genome, but becomes essential in strains lacking the mitochondrial genome, referred to as rho- or rho0. Petite-negative strains cannot grow on fermentable carbon sources (e.g., glucose) in the absence of an intact mitochondrial genome. This phenotype is often assayed as the inability grow in the presence of ethidium bromide, which causes the loss of the mitochondrial genome." ;
                oboInOwl:hasAlternativeId "YPO:0000154" ;
                oboInOwl:hasOBONamespace "observable" ;
                oboInOwl:id "APO:0000154" ;
                oboInOwl:inSubset apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "petite-negative" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000154 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The petite-negative phenotype arises from mutation in a nuclear gene that is not essential in an otherwise wild-type strain with an intact mitochondrial genome, but becomes essential in strains lacking the mitochondrial genome, referred to as rho- or rho0. Petite-negative strains cannot grow on fermentable carbon sources (e.g., glucose) in the absence of an intact mitochondrial genome. This phenotype is often assayed as the inability grow in the presence of ethidium bromide, which causes the loss of the mitochondrial genome." ;
   oboInOwl:hasDbXref "PMID:16267274" ,
                      "SGD:mcc"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000155
obo:APO_0000155 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000312 ;
                obo:IAO_0000115 "An energy-dependent, programmed form of cell death that is characterized by phenotypic markers such as increased levels of reactive oxygen species (often detected via DHE staining), externalization of phosphatidylserine (measured by annexin V staining), and DNA fragmentation (detected using the TUNEL assay). Other processes observed during apoptosis include chromosome condensation and breakdown of mitochondria, including loss of membrane potential and release of cytochrome c. Cells undergoing apoptosis do not lose plasma membrane integrity (measured by propidium iodide staining) until late in the process." ;
                oboInOwl:hasAlternativeId "YPO:0000155" ;
                oboInOwl:hasOBONamespace "observable" ;
                oboInOwl:id "APO:0000155" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "apoptosis" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000155 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An energy-dependent, programmed form of cell death that is characterized by phenotypic markers such as increased levels of reactive oxygen species (often detected via DHE staining), externalization of phosphatidylserine (measured by annexin V staining), and DNA fragmentation (detected using the TUNEL assay). Other processes observed during apoptosis include chromosome condensation and breakdown of mitochondria, including loss of membrane potential and release of cytochrome c. Cells undergoing apoptosis do not lose plasma membrane integrity (measured by propidium iodide staining) until late in the process." ;
   oboInOwl:hasDbXref "PMID:15556039" ,
                      "PMID:18452540" ,
                      "PMID:18500447" ,
                      "PMID:18782613" ,
                      "PMID:19416362" ,
                      "SGD:mcc"
 ] .


