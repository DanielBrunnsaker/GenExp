[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000013 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation reduces the activity of the gene product." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000014
obo:APO_0000014 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The activity of the gene product is normal under some conditions and altered under others." ;
                oboInOwl:hasAlternativeId "YPO:0000014" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000014" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "conditional" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000014 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The activity of the gene product is normal under some conditions and altered under others." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000015
obo:APO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation type is not specified in the reference." ;
                oboInOwl:hasAlternativeId "YPO:0000015" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000015" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
