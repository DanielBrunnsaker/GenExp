@prefix : <http://purl.obolibrary.org/obo/apo.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix apo: <http://purl.obolibrary.org/obo/apo#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <http://purl.obolibrary.org/obo/apo.owl#> .

<http://hypo.project-genesis.io#> rdf:type owl:Ontology ;
                                   owl:versionIRI <http://hypo.project-genesis.io#0.0.1> ;
                                   dc:contributor "Alexander Gower" ,
                                                  "Filip Kronström" ;
                                   dc:title "Genesis Hypothesis Ontology" ;
                                   terms:license <http://creativecommons.org/licenses/by/4.0/> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty ;
                rdfs:label "definition" .


###  http://purl.obolibrary.org/obo/IAO_0000231
obo:IAO_0000231 rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0100001
obo:IAO_0100001 rdf:type owl:AnnotationProperty ;
                rdfs:label "term replaced by" .


###  http://purl.obolibrary.org/obo/apo#AspGD
apo:AspGD rdf:type owl:AnnotationProperty ;
          rdfs:comment "APO terms in use at AspGD" ;
          rdfs:subPropertyOf oboInOwl:SubsetProperty .


###  http://purl.obolibrary.org/obo/apo#CGD
apo:CGD rdf:type owl:AnnotationProperty ;
        rdfs:comment "APO terms in use at CGD" ;
        rdfs:subPropertyOf oboInOwl:SubsetProperty .


###  http://purl.obolibrary.org/obo/apo#CryptoGD
apo:CryptoGD rdf:type owl:AnnotationProperty ;
             rdfs:comment "APO terms in use at CryptoGD" ;
             rdfs:subPropertyOf oboInOwl:SubsetProperty .


###  http://purl.obolibrary.org/obo/apo#SGD
apo:SGD rdf:type owl:AnnotationProperty ;
        rdfs:comment "APO terms in use at SGD" ;
        rdfs:subPropertyOf oboInOwl:SubsetProperty .


###  http://purl.obolibrary.org/obo/apo#phenotypeslim_cerevisiae
apo:phenotypeslim_cerevisiae rdf:type owl:AnnotationProperty ;
                             rdfs:comment "Phenotype Slim terms for S. cerevisiae" ;
                             rdfs:subPropertyOf oboInOwl:SubsetProperty .


###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
terms:license rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#NamespaceIdRule
oboInOwl:NamespaceIdRule rdf:type owl:AnnotationProperty ;
                         rdfs:label "namespace-id-rule" .


###  http://www.geneontology.org/formats/oboInOwl#SubsetProperty
oboInOwl:SubsetProperty rdf:type owl:AnnotationProperty ;
                        rdfs:label "subset_property" .


###  http://www.geneontology.org/formats/oboInOwl#auto-generated-by
oboInOwl:auto-generated-by rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#consider
oboInOwl:consider rdf:type owl:AnnotationProperty ;
                  rdfs:label "consider" .


###  http://www.geneontology.org/formats/oboInOwl#created_by
oboInOwl:created_by rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#creation_date
oboInOwl:creation_date rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#date
oboInOwl:date rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#default-namespace
oboInOwl:default-namespace rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasAlternativeId
oboInOwl:hasAlternativeId rdf:type owl:AnnotationProperty ;
                          rdfs:label "has_alternative_id" .


###  http://www.geneontology.org/formats/oboInOwl#hasDbXref
oboInOwl:hasDbXref rdf:type owl:AnnotationProperty ;
                   rdfs:label "database_cross_reference" .


###  http://www.geneontology.org/formats/oboInOwl#hasExactSynonym
oboInOwl:hasExactSynonym rdf:type owl:AnnotationProperty ;
                         rdfs:label "has_exact_synonym" .


###  http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion
oboInOwl:hasOBOFormatVersion rdf:type owl:AnnotationProperty ;
                             rdfs:label "has_obo_format_version" .


###  http://www.geneontology.org/formats/oboInOwl#hasOBONamespace
oboInOwl:hasOBONamespace rdf:type owl:AnnotationProperty ;
                         rdfs:label "has_obo_namespace" .


###  http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym
oboInOwl:hasRelatedSynonym rdf:type owl:AnnotationProperty ;
                           rdfs:label "has_related_synonym" .


###  http://www.geneontology.org/formats/oboInOwl#id
oboInOwl:id rdf:type owl:AnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#inSubset
oboInOwl:inSubset rdf:type owl:AnnotationProperty ;
                  rdfs:label "in_subset" .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#deprecated
owl:deprecated rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://hypo.project-genesis.io#absentComparedTo
:absentComparedTo rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :decreasedComparedTo .


###  http://hypo.project-genesis.io#arrestedComparedTo
:arrestedComparedTo rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#decreasedComparedTo
:decreasedComparedTo rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :differsFrom ;
                     obo:IAO_0000115 "The observed feature is decreased in the source phenotype compared to that in the target phenotype (faster, stronger, higher, larger, etc.)." .


###  http://hypo.project-genesis.io#decreasedDurationComparedTo
:decreasedDurationComparedTo rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#decreasedRateComparedTo
:decreasedRateComparedTo rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#delayedComparedTo
:delayedComparedTo rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#differsFrom
:differsFrom rdf:type owl:ObjectProperty .


###  http://hypo.project-genesis.io#increasedComparedTo
:increasedComparedTo rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :differsFrom ;
                     obo:IAO_0000115 "The observed feature is increased in the source phenotype compared to that in the target phenotype (faster, stronger, higher, larger, etc.)." .


###  http://hypo.project-genesis.io#increasedDurationComparedTo
:increasedDurationComparedTo rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#increasedRateComparedTo
:increasedRateComparedTo rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :differsFrom .


###  http://hypo.project-genesis.io#notDiffersFrom
:notDiffersFrom rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty .


###  http://hypo.project-genesis.io#prematureComparedTo
:prematureComparedTo rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :differsFrom .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/APO_0000001
obo:APO_0000001 rdf:type owl:Class ;
                obo:IAO_0000115 "The direction of change in the mutant compared to wild type." ;
                oboInOwl:hasAlternativeId "YPO:0000001" ;
                oboInOwl:hasOBONamespace "qualifier" ;
                oboInOwl:id "APO:0000001" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "qualifier" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000001 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The direction of change in the mutant compared to wild type." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000002
obo:APO_0000002 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000001 ;
                obo:IAO_0000115 "The observed phenotype is detectably different from that in the wild type." ;
                oboInOwl:hasAlternativeId "YPO:0000002" ;
                oboInOwl:hasOBONamespace "qualifier" ;
                oboInOwl:id "APO:0000002" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "abnormal" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000002 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The observed phenotype is detectably different from that in the wild type." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000003
obo:APO_0000003 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000002 ;
                obo:IAO_0000115 "The observed feature is decreased compared to that in the wild type (slower, weaker, lower, smaller, etc.)." ;
                oboInOwl:hasAlternativeId "YPO:0000003" ;
                oboInOwl:hasOBONamespace "qualifier" ;
                oboInOwl:id "APO:0000003" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "decreased" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000003 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The observed feature is decreased compared to that in the wild type (slower, weaker, lower, smaller, etc.)." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000004
obo:APO_0000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000002 ;
                obo:IAO_0000115 "The observed feature is increased compared to that in the wild type (faster, stronger, higher, larger, etc.)." ;
                oboInOwl:hasAlternativeId "YPO:0000004" ;
                oboInOwl:hasOBONamespace "qualifier" ;
                oboInOwl:id "APO:0000004" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "increased" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000004 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The observed feature is increased compared to that in the wild type (faster, stronger, higher, larger, etc.)." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000005
obo:APO_0000005 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000003 ;
                obo:IAO_0000115 "The observed feature is not detectable in the mutant." ;
                oboInOwl:hasAlternativeId "YPO:0000005" ;
                oboInOwl:hasOBONamespace "qualifier" ;
                oboInOwl:id "APO:0000005" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "absent" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000005 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The observed feature is not detectable in the mutant." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000006
obo:APO_0000006 rdf:type owl:Class ;
                obo:IAO_0000115 "A description of the effect of the mutation on the gene product function." ;
                oboInOwl:hasAlternativeId "YPO:0000006" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000006" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "mutant_type" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000006 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A description of the effect of the mutation on the gene product function." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000007
obo:APO_0000007 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation results in expression of the gene product at a developmental stage, in a cell type, or at a subcellular location different from that at which the wild-type gene is expressed." ;
                oboInOwl:hasAlternativeId "YPO:0000007" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000007" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "misexpression" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000007 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation results in expression of the gene product at a developmental stage, in a cell type, or at a subcellular location different from that at which the wild-type gene is expressed." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000008
obo:APO_0000008 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation causes expression of the otherwise normal gene product to higher levels than wild-type." ;
                oboInOwl:hasAlternativeId "YPO:0000008" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000008" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "overexpression" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000008 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation causes expression of the otherwise normal gene product to higher levels than wild-type." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000009
obo:APO_0000009 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation increases the normal activity of a gene product." ;
                oboInOwl:hasAlternativeId "YPO:0000009" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000009" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "activation" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000009 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation increases the normal activity of a gene product." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000010
obo:APO_0000010 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation confers a new activity on the gene product." ;
                oboInOwl:hasAlternativeId "YPO:0000010" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000010" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "gain of function" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000010 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation confers a new activity on the gene product." ;
   oboInOwl:hasDbXref "SGD:curators"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000011
obo:APO_0000011 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation abolishes completely the function of the gene product." ;
                oboInOwl:hasAlternativeId "YPO:0000011" ;
                oboInOwl:hasExactSynonym "null" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:hasRelatedSynonym "loss of function" ;
                oboInOwl:id "APO:0000011" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "null mutant" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000011 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation abolishes completely the function of the gene product." ;
   oboInOwl:hasDbXref "SGD:RSN"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000011 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "loss of function" ;
   oboInOwl:hasDbXref "SGD:RSN"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000012
obo:APO_0000012 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation leads to reduction of levels of the gene product, often through the use of a repressible promoter." ;
                oboInOwl:hasAlternativeId "YPO:0000012" ;
                oboInOwl:hasExactSynonym "depletion" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000012" ;
                oboInOwl:inSubset apo:AspGD ,
                                  apo:CGD ,
                                  apo:CryptoGD ,
                                  apo:SGD ;
                rdfs:label "repressible" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000012 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The mutation leads to reduction of levels of the gene product, often through the use of a repressible promoter." ;
   oboInOwl:hasDbXref "SGD:RSN"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:APO_0000012 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "depletion" ;
   oboInOwl:hasDbXref "SGD:RSN"
 ] .


###  http://purl.obolibrary.org/obo/APO_0000013
obo:APO_0000013 rdf:type owl:Class ;
                rdfs:subClassOf obo:APO_0000006 ;
                obo:IAO_0000115 "The mutation reduces the activity of the gene product." ;
                oboInOwl:hasAlternativeId "YPO:0000013" ;
                oboInOwl:hasOBONamespace "mutant_type" ;
                oboInOwl:id "APO:0000013" ;
                oboInOwl:inSubset apo:AspGD ,
