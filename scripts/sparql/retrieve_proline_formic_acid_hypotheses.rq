PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX : <http://hypo.project-genesis.io#>

SELECT ?hypothesis ?title ?creator ?created ?state1 ?state2 ?accProline
WHERE {
    GRAPH ?hypothesis {
        ?state1 rdfs:subClassOf ?r1 .
        ?r1 a owl:Restriction ;
            owl:onProperty :implies ;
            owl:someValuesFrom ?state2 .  
    }

    GRAPH <http://hypo.project-genesis.io/states> {
        ?state1 rdfs:subClassOf ?r2 .
        ?r2 a owl:Restriction ;
            owl:onProperty :stateHasObservable ;
            owl:someValuesFrom ?accProline .
    }

    GRAPH <http://hypo.project-genesis.io/phenotypes> {
        ?accProline rdfs:subClassOf <http://purl.obolibrary.org/obo/APO_0000095> .
        ?accProline rdfs:subClassOf ?r3 .
        ?r3 a owl:Restriction ;
            owl:onProperty :accumulationOfChemical ;
            owl:someValuesFrom <http://purl.obolibrary.org/obo/CHEBI_26271> .
    }

    GRAPH <http://hypo.project-genesis.io/hypothesis-metadata> {
        # ?hypothesis a :hypothesis .
        OPTIONAL { ?hypothesis dct:title ?title . }
        OPTIONAL { ?hypothesis dct:creator ?creator . }
        OPTIONAL { ?hypothesis dct:created ?created . }
    }
}